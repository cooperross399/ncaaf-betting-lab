.venv/
__pycache__/
*.pyc
.env
.DS_Store

# Bought prices and fetched feeds. Large, re-fetchable, and the raw cache is
# where provider event ids live — which are 32-hex and the same shape as an
# API key, so the secrets guard exempts them BY RECORDED VALUE, never by
# directory.
data/raw/
data/processed/*.csv
data/staging/

.pytest_cache/
*.egg-info/

# The card path's per-run state. The ledger and the snapshots live on the
# `card-feed` branch, never on main: they are restored from it at the start of
# a run and published back to it at the end.
data/archive/
data/rehearsal_archive/
data/outputs/ncaaf_card_run.json
data/outputs/ncaaf_card_previous_selections.json
data/outputs/ncaaf_gameday_card.md
data/outputs/ncaaf_provider_fetch.md
